start_gui
open_project D:/FPGA/mqnic_prj/mqnic_prj.xpr
open_hw_manager
update_compile_order -fileset sources_1
connect_hw_server -allow_non_jtag
open_hw_target
open_run impl_1
puts "DEBUG CORES = [get_debug_cores]"
set hub [get_debug_cores dbg_hub]
if {[llength $hub] == 0} {
    error "Implemented design does not contain dbg_hub"
}
set scan_chain [get_property C_USER_SCAN_CHAIN $hub]
set scan_mask [expr {1 << ($scan_chain-1)}]
puts "C_USER_SCAN_CHAIN = $scan_chain"
puts "BSCAN mask = $scan_mask"
write_debug_probes -force \
    {D:/FPGA/mqnic_prj/mqnic_prj.runs/impl_1/fpga.ltx}
open_hw_manager
connect_hw_server
if {[llength [get_hw_devices]] == 0} {
    open_hw_target
}
puts "HW devices = [get_hw_devices]"
set dev [lindex [get_hw_devices xczu7*] 0]
if {$dev eq ""} {
    error "没有找到 xczu7 FPGA，请检查JTAG连接"
}
{}
}current_hw_device $dev
current_hw_device $dev
set_property PROGRAM.FILE \
    {D:/FPGA/mqnic_prj/mqnic_prj.runs/impl_1/fpga.bit} $dev
open_hw_target
set dev [lindex [get_hw_devices xczu7*] 0]
current_hw_device $dev
set_property PROGRAM.FILE "D:/FPGA/mqnic_prj/mqnic_prj.runs/impl_1/fpga.bit" $dev
set_property PROBES.FILE "D:/FPGA/mqnic_prj/mqnic_prj.runs/impl_1/fpga.ltx" $dev
set_property BSCAN_SWITCH_USER_MASK 1 $dev
puts "BIT = [get_property PROGRAM.FILE $dev]"
get_hw_devices
